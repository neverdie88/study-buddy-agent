# Copy to .env for local development. NEVER commit real secrets.
# Secrets (e.g. Google Calendar OAuth credentials) live in Google Cloud Secret Manager.

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Strategic model routing
BUDDY_FAST_MODEL=gemini-3.8-flash
BUDDY_REASONING_MODEL=gemini-3.1-pro-preview

# Kid profile (nickname only - no real names)
BUDDY_KID_ID=kid-001
BUDDY_KID_NAME=Star
BUDDY_KID_GRADE=3
BUDDY_KID_TIMEZONE=Australia/Sydney

# Storage: sqlite (local) | firestore (cloud)
BUDDY_STORAGE_BACKEND=sqlite
# BUDDY_SESSION_DB_URL=sqlite+aiosqlite:///.data/adk_sessions.db

# Calendar: local | google  (google reads credentials from Secret Manager)
BUDDY_CALENDAR_BACKEND=local
BUDDY_CALENDAR_SECRET_NAME=study-buddy-calendar-credentials
BUDDY_GOOGLE_CALENDAR_ID=primary

# Optional: Vertex AI Search data store with the parent's uploaded school materials
# BUDDY_VERTEX_SEARCH_DATASTORE=projects/PROJECT/locations/global/collections/default_collection/dataStores/DATASTORE_ID

# Optional: Model Armor template for prompt screening
# BUDDY_MODEL_ARMOR_TEMPLATE=projects/PROJECT/locations/us-central1/templates/kid-safe

# Observability
BUDDY_ENABLE_CLOUD_TRACE=false
BUDDY_ENABLE_CLOUD_LOGGING=false
BUDDY_ENABLE_CLOUD_DLP=false
BUDDY_LOG_LEVEL=INFO
